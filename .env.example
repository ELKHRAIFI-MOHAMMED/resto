# =============================================================================
# RestoFlow — environment configuration
# Copy to `.env` (never commit it) and replace every placeholder value.
# The same file is read by Django, Docker Compose and the Vite dev server.
# =============================================================================

# --- Django ------------------------------------------------------------------
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-generate-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Django's built-in admin (the React dashboard owns /admin/)
DJANGO_ADMIN_URL=django-admin/
DJANGO_LOG_LEVEL=INFO

# Only needed when the frontend is served from a different origin than the API
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- PostgreSQL (used by docker-compose.yml and by Django) -------------------
POSTGRES_DB=restoflow
POSTGRES_USER=restoflow
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional: a full URL overrides the POSTGRES_* values above (hosting platforms)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Ordering & limits (optional, defaults shown) ----------------------------
# ORDER_REFERENCE_PREFIX=RF
# THROTTLE_ANON=120/minute
# THROTTLE_ORDERS=10/minute
# THROTTLE_LOGIN=5/minute
# MAX_IMAGE_UPLOAD_SIZE=5242880

# --- Frontend (Vite) ---------------------------------------------------------
# Only VITE_* variables are exposed to browser code. Never put secrets in them.
VITE_API_BASE_URL=/api
# Where the Vite dev server proxies /api and /media requests
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
