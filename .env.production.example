# =============================================================================
# RestoFlow — production environment (copy to .env.production, never commit it)
# Used by docker-compose.prod.yml. Replace EVERY placeholder.
# =============================================================================

# --- Django ------------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-generate-a-long-random-secret
DJANGO_ALLOWED_HOSTS=resto.example.com,www.resto.example.com
CSRF_TRUSTED_ORIGINS=https://resto.example.com,https://www.resto.example.com
PUBLIC_SITE_URL=https://resto.example.com
# Built-in Django admin: must start with django-admin/ (the only prefix nginx
# forwards to Django); add a private segment to keep it out of sight.
DJANGO_ADMIN_URL=django-admin/change-me-private-path/
DJANGO_LOG_LEVEL=INFO

# HTTPS is terminated by the proxy in front of nginx (see docs/deployment.md).
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=2592000

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_DB=restoflow
POSTGRES_USER=restoflow
POSTGRES_PASSWORD=change-me-long-random-database-password

# --- Web server ----------------------------------------------------------------
# Host port nginx listens on (80 behind a TLS proxy on the same machine)
HTTP_PORT=80
# Gunicorn workers (2 x CPU cores + 1 is a good start)
WEB_CONCURRENCY=3

# First owner account, created with the initial menu on a brand-new database.
# Leave empty to create it with `python manage.py createsuperuser` instead.
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PASSWORD=
